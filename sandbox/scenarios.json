        {"label": "Jouer Destroy sur l'Interzone adverse", "send": {
          "type": "declare_rules_action", "label": "Destroy", "kind": "play_card",
          "source": {"cardId": "$card", "zone": "hand"}, "abilityId": "destroy-field-will-or-interzone-manifestation",
          "paymentCardIds": ["%pay"],
          "targets": [{"kind": "card", "itemId": "@opp-interzone", "cardId": "%victim"}]
