        "opp": {"hand": 2, "deck": 6, "graveyard": 1}
      },
      "battlefield": [
        {"id": "borombo", "owner": "me", "card": "$card", "zone": "confrontation", "first": true},
        {"id": "opp-fighter", "owner": "opp", "card": {"card": "vanilla:vitreous:4", "as": "winner"}, "zone": "confrontation", "first": true}
      ],
      "checks": [
        "Passe : Borombo (Colérique 3) perd contre une Vitreuse 4.",
        "Au moment de la perte, l'UI te demande une cible en Confrontation adverse.",
        "À la résolution, le gagnant adverse est détruit."
      ],
      "script": [
        {"label": "Passer jusqu'au choix de cible de Borombo", "passUntil": {"choice": "trigger_targets"}},
        {"label": "Choisir le combattant adverse", "choose": {"targets": [{"kind": "card", "itemId": "@opp-fighter", "cardId": "%winner"}]}},
        {"label": "La capacité est sur la Pile", "expect": {"stack": 1}},
        {"label": "Les deux joueurs passent", "resolve": true},
        {"label": "Le gagnant est détruit", "expect": {"zone": "opp.graveyard", "contains": "%winner"}}
      ]
    }
